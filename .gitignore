# ============================================================
# .gitignore - BVC Analysis
# ============================================================

# Variables de entorno (IMPORTANTE: NO SUBIR)
.env
.env.local
.env.production
backend/.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
*.log

# Archivos generados
*.png
*.pdf
*.csv
*.xlsx
backup*.sql

# Frontend build
frontend/build/
frontend/.next/
frontend/out/

# Docker
.dockerignore

# Bases de datos locales
*.db
*.sqlite
*.sqlite3

# Certificados y claves
*.pem
*.key
*.crt

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp
*~

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Pytest
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Logs
logs/
*.log
